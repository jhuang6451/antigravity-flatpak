[Desktop Entry]
Name=Antigravity
GenericName=IDE
Comment=Google's agentic IDE
Exec=antigravity %U
Icon=com.google.Antigravity
Type=Application
StartupNotify=true
StartupWMClass=Antigravity
Categories=Development;IDE;
MimeType=x-scheme-handler/antigravity;
Keywords=google;antigravity;ide;ai;agent;development;coding;
Actions=NewWindow;

[Desktop Action NewWindow]
Name=New Window
Exec=antigravity --new-window %U
